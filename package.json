{
  "name": "vite-vue-explicit-imports",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "repository": "https://github.com/hdmy/vite-vue-explicit-imports",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./vite": {
      "types": "./dist/vite.d.mts",
      "import": "./dist/vite.mjs"
    }
  },
  "bin": {
    "vite-vue-explicit-imports": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "skills"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@vue/compiler-sfc": "^3.5.0",
    "cac": "^6.7.14",
    "magic-string": "^0.30.0",
    "oxc-parser": "^0.158.0",
    "oxc-walker": "^1.1.1",
    "pathe": "^2.0.0",
    "picomatch": "^4.0.0",
    "tinyglobby": "^0.2.0"
  },
  "peerDependencies": {
    "vite": ">=5.0.0",
    "vue": ">=3.3.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/picomatch": "^4.0.0",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.0",
    "vue": "^3.5.0"
